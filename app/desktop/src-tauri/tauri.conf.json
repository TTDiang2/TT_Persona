{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TT_Persona",
  "version": "0.1.0",
  "identifier": "com.ttdiang2.ttpersona",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5273"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TT_Persona",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": false,
        "backgroundColor": "#F7F6F3"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
